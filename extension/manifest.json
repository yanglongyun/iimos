{
  "manifest_version": 3,
  "name": "iimos 浏览器连接",
  "version": "0.1.0",
  "description": "把你登着账号的浏览器借给 iimos:它能打开、读取、点击你共享给它的网页。只操作你共享的标签页和它自己开的标签页。",
  "minimum_chrome_version": "120",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "连接 iimos",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
