{
  "name": "morphic",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "morphic —— 一个可以完全修改自己的 Agent:一个对话,一个 shell,其余都由它自己长",
  "author": "woodchange",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanglongyun/morphic.git"
  },
  "homepage": "https://github.com/yanglongyun/morphic#readme",
  "bugs": {
    "url": "https://github.com/yanglongyun/morphic/issues"
  },
  "main": "shell/main.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "app": "npm run build:ui && electron shell/main.js",
    "app:direct": "npm run build:ui && node app/main.js",
    "build:ui": "node launcher/cli-build.js",
    "typecheck": "tsc -p app/ui/tsconfig.json",
    "test": "npm run build:ui && node --test \"launcher/**/*.test.js\" \"app/test/*.test.js\"",
    "build:app": "npm run build:ui && node scripts/pack.mjs",
    "release:mac": "npm run build:ui && electron-builder",
    "ship:mac": "node scripts/release-mac.mjs",
    "release:win": "npm run build:ui && node scripts/pack.mjs --win nsis --x64"
  },
  "dependencies": {
    "isomorphic-git": "^1.43.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "ai.iimos.morphic",
    "productName": "morphic",
    "directories": {
      "app": ".",
      "output": "dist"
    },
    "files": [
      "launcher/**/*",
      "shell/**/*",
      "build/trayTemplate*.png",
      "build/icon.png",
      "!**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "seed",
        "filter": [
          "**/*",
          "!test/**",
          "!.data/**"
        ]
      },
      {
        "from": "node_modules/esbuild",
        "to": "toolchain/node_modules/esbuild",
        "filter": [
          "**/*",
          "!bin/**"
        ]
      },
      {
        "from": "node_modules/@esbuild",
        "to": "toolchain/node_modules/@esbuild"
      },
      {
        "from": "node_modules/react",
        "to": "toolchain/node_modules/react",
        "filter": [
          "**/*",
          "!cjs/*.development.js",
          "!cjs/*server*",
          "!*server*",
          "!cjs/*test-utils*"
        ]
      },
      {
        "from": "node_modules/react-dom",
        "to": "toolchain/node_modules/react-dom",
        "filter": [
          "**/*",
          "!cjs/*.development.js",
          "!cjs/*server*",
          "!*server*",
          "!cjs/*test-utils*"
        ]
      },
      {
        "from": "node_modules/scheduler",
        "to": "toolchain/node_modules/scheduler",
        "filter": [
          "**/*",
          "!cjs/*.development.js"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Chuan Zhi (Chengdu) Information Technology Co., Ltd. (92696T726U)"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "morphic-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "morphic",
      "runAfterFinish": true
    }
  },
  "bin": {
    "morphic": "launcher/cli.js"
  }
}
