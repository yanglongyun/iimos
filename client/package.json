{
  "name": "iimos",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "iimos —— 住在你自己机器上、一直醒着、会长出自己身体的个人 Agent",
  "author": "woodchange",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanglongyun/iimos.git"
  },
  "homepage": "https://github.com/yanglongyun/iimos#readme",
  "bugs": {
    "url": "https://github.com/yanglongyun/iimos/issues"
  },
  "main": "shell/main.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "app": "npm run build:ui && electron shell/main.js",
    "app:direct": "npm run build:ui && node app/main.js",
    "build:ui": "node launcher/cli-build.js",
    "build:hands": "node hands/build.js",
    "typecheck": "tsc -p app/ui/tsconfig.json",
    "test": "npm run build:ui && node --test \"launcher/**/*.test.js\" \"app/test/*.test.js\" \"hands/**/*.test.js\"",
    "build:app": "npm run build:ui && npm run build:hands && node scripts/pack.mjs",
    "release:mac": "npm run build:ui && npm run build:hands && electron-builder",
    "ship:mac": "node scripts/release-mac.mjs"
  },
  "dependencies": {
    "isomorphic-git": "^1.43.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "ai.iimos.desktop",
    "productName": "iimos",
    "directories": {
      "app": ".",
      "output": "dist"
    },
    "files": [
      "launcher/**/*",
      "shell/**/*",
      "hands/*.js",
      "build/trayTemplate*.png",
      "build/icon.png",
      "!**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "seed",
        "filter": [
          "**/*",
          "!test/**",
          "!.data/**"
        ]
      },
      {
        "from": "node_modules/esbuild",
        "to": "toolchain/node_modules/esbuild",
        "filter": [
          "**/*",
          "!bin/**"
        ]
      },
      {
        "from": "node_modules/@esbuild",
        "to": "toolchain/node_modules/@esbuild"
      },
      {
        "from": "node_modules/react",
        "to": "toolchain/node_modules/react",
        "filter": [
          "**/*",
          "!cjs/*.development.js",
          "!cjs/*server*",
          "!*server*",
          "!cjs/*test-utils*"
        ]
      },
      {
        "from": "node_modules/react-dom",
        "to": "toolchain/node_modules/react-dom",
        "filter": [
          "**/*",
          "!cjs/*.development.js",
          "!cjs/*server*",
          "!*server*",
          "!cjs/*test-utils*"
        ]
      },
      {
        "from": "node_modules/scheduler",
        "to": "toolchain/node_modules/scheduler",
        "filter": [
          "**/*",
          "!cjs/*.development.js"
        ]
      },
      {
        "from": "hands/runtime",
        "to": "runtime",
        "filter": [
          "iimos-computer"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Chuan Zhi (Chengdu) Information Technology Co., Ltd. (92696T726U)",
      "binaries": [
        "Contents/Resources/runtime/iimos-computer"
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "iimos 要看屏幕,才能按你的要求操作这台电脑。",
        "NSAppleEventsUsageDescription": "iimos 要控制其他应用,才能按你的要求操作这台电脑。"
      }
    }
  },
  "bin": {
    "iimos": "launcher/cli.js"
  }
}
